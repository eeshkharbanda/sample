rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person (mobile login or guest) can read and write only their own data.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['bags'])
                   && request.resource.data.bags is list && request.resource.data.bags.size() <= 200;

      match /products/{pid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['name', 'L', 'B', 'H', 'M', 'soft', 'updatedAt'])
                              && request.resource.data.name is string && request.resource.data.name.size() <= 80
                              && request.resource.data.L is number && request.resource.data.B is number
                              && request.resource.data.H is number && request.resource.data.M is number
                              && request.resource.data.soft is bool;
      }
    }
    // Everything else is closed.
  }
}
